      "label": "Data limite do reforço",
      "group": "Preço e pagamento",
      "required": false
    },
    "remanescente_valor": {
      "label": "Remanescente a pagar na escritura",
      "group": "Preço e pagamento",
      "required": true
    },
    "financiamento": {
      "label": "Condição de financiamento bancário?",
      "group": "Financiamento",
      "required": false,
      "help": "Ativa ou desativa o bloco correspondente do contrato."
    },
    "financiamento_prazo": {
      "label": "Data limite de aprovação do financiamento",
      "group": "Financiamento",
      "required": false
    },
    "escritura_data_limite": {
      "label": "Data limite do contrato definitivo",
      "group": "Prazos",
      "required": true
    },
    "aviso_dias": {
      "label": "Dias úteis de aviso da escritura",
      "group": "Prazos",
      "required": true,
      "default": "8"
    },
    "incumprimento_prazo_dias": {
      "label": "Dias para sanar incumprimento após notificação",
      "group": "Prazos",
      "required": true,
      "default": "10"
    },
    "documentos_prazo_dias": {
      "label": "Dias úteis para entregar documentos",
      "group": "Prazos",
      "required": true,
      "default": "2"
    },
    "condominio_prazo_dias": {
      "label": "Dias para entregar declaração do condomínio",
      "group": "Prazos",
      "required": true,
      "default": "20"
    },
    "domicilio_prazo_dias": {
      "label": "Dias para comunicar mudança de morada",
      "group": "Prazos",
      "required": true,
      "default": "15"
    },
