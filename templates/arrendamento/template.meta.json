{
  "id": "arrendamento",
  "title": "Contrato de Arrendamento Urbano para Habitação",
  "version": "0.1.0",
  "groups": [
    { "id": "Senhorio", "label": "Senhorio", "order": 0 },
    { "id": "Arrendatário", "label": "Arrendatário", "order": 1 },
    { "id": "Imóvel", "label": "Imóvel", "order": 2 },
    { "id": "Estado e mobiliário", "label": "Estado e mobiliário", "order": 3 },
    { "id": "Prazo e renda", "label": "Prazo e renda", "order": 4 },
    { "id": "Caução", "label": "Caução", "order": 5 },
    { "id": "Animais", "label": "Animais de companhia", "order": 6 },
    { "id": "Fiador", "label": "Fiador", "order": 7 },
    { "id": "Foro e assinatura", "label": "Foro e assinatura", "order": 8 }
  ],
  "fields": {
    "senhorio_nome": { "required": true, "label": "Nome do senhorio", "group": "Senhorio" },
    "senhorio_estado_civil": { "required": true, "label": "Estado civil (e regime de bens, se casado)", "group": "Senhorio", "options": ["Solteiro(a), maior", "Casado(a) em comunhão de adquiridos", "Casado(a) em comunhão geral de bens", "Casado(a) em separação de bens", "Divorciado(a)", "Viúvo(a)", "União de facto"] },
    "senhorio_nif": { "required": true, "label": "NIF do senhorio", "group": "Senhorio" },
    "senhorio_morada": { "required": true, "label": "Morada de residência do senhorio", "group": "Senhorio" },
    "senhorio_iban": { "required": true, "label": "IBAN para receber a renda", "group": "Senhorio" },
    "senhorio_banco": { "required": true, "label": "Banco do IBAN", "group": "Senhorio" },
    "senhorio_email": { "required": true, "label": "E-mail do senhorio", "group": "Senhorio" },
    "arrendatario_nome": { "required": true, "label": "Nome do arrendatário", "group": "Arrendatário" },
    "arrendatario_estado_civil": { "required": true, "label": "Estado civil (e regime de bens, se casado)", "group": "Arrendatário", "options": ["Solteiro(a), maior", "Casado(a) em comunhão de adquiridos", "Casado(a) em comunhão geral de bens", "Casado(a) em separação de bens", "Divorciado(a)", "Viúvo(a)", "União de facto"] },
    "arrendatario_nif": { "required": true, "label": "NIF do arrendatário", "group": "Arrendatário" },
    "arrendatario_morada_atual": { "required": true, "label": "Morada atual do arrendatário", "group": "Arrendatário" },
    "arrendatario_email": { "required": true, "label": "E-mail do arrendatário", "group": "Arrendatário" },
    "imovel_tipologia": { "required": true, "label": "Tipologia (ex.: T2)", "group": "Imóvel", "options": ["T0", "T1", "T2", "T3", "T4", "T5", "T6 ou superior"] },
    "imovel_fracao": { "required": true, "label": "Fração", "group": "Imóvel", "emptyText": "N/A" },
    "imovel_morada": { "required": true, "label": "Morada do locado", "group": "Imóvel" },
    "imovel_freguesia": { "required": true, "label": "Freguesia", "group": "Imóvel" },
    "imovel_concelho": { "required": true, "label": "Concelho", "group": "Imóvel" },
    "imovel_conservatoria": { "required": true, "label": "Conservatória do Registo Predial", "group": "Imóvel" },
    "imovel_descricao_registo": { "required": true, "label": "N.º de descrição predial", "group": "Imóvel" },
    "imovel_artigo_matricial": { "required": true, "label": "Artigo da matriz", "group": "Imóvel" },
    "imovel_licenca_utilizacao": { "required": true, "label": "N.º da licença de utilização", "group": "Imóvel" },
    "imovel_certificado_energetico": { "required": true, "label": "N.º do certificado energético", "group": "Imóvel" },
    "mobilado": { "required": true, "label": "O locado é arrendado mobilado?", "group": "Estado e mobiliário", "help": "Ativa ou desativa o bloco correspondente do contrato." },
    "mobiliario_descricao": { "label": "Inventário de mobiliário e equipamentos", "group": "Estado e mobiliário" },
    "obras_previas": { "label": "Há defeitos ou obras pendentes a declarar?", "group": "Estado e mobiliário", "help": "Ativa ou desativa o bloco correspondente do contrato." },
    "obras_previas_descricao": { "label": "Descrição do estado/defeitos/obras pendentes", "group": "Estado e mobiliário" },
    "prazo_meses": { "required": true, "label": "Duração inicial (meses)", "group": "Prazo e renda", "default": "12" },
    "data_inicio": { "required": true, "label": "Data de início do contrato", "group": "Prazo e renda" },
    "renda_valor": { "required": true, "label": "Valor da renda mensal", "group": "Prazo e renda" },
    "renda_dia_pagamento": { "required": true, "label": "Dia de pagamento da renda", "group": "Prazo e renda", "default": "8" },
    "caucao": { "label": "Há lugar a caução?", "group": "Caução", "help": "Ativa ou desativa o bloco correspondente do contrato." },
    "caucao_valor": { "label": "Valor da caução", "group": "Caução" },
    "animais_permitidos": { "required": true, "label": "São permitidos animais de companhia?", "group": "Animais", "help": "Ativa ou desativa o bloco correspondente do contrato." },
    "fiador": { "label": "Há fiador?", "group": "Fiador", "help": "Ativa ou desativa o bloco correspondente do contrato." },
    "fiador_nome": { "label": "Nome do fiador", "group": "Fiador" },
    "fiador_nif": { "label": "NIF do fiador", "group": "Fiador" },
    "fiador_morada": { "label": "Morada do fiador", "group": "Fiador" },
    "foro_comarca": { "required": true, "label": "Comarca do foro", "group": "Foro e assinatura" },
    "contrato_local": { "required": true, "label": "Local de assinatura", "group": "Foro e assinatura" },
    "contrato_data": { "required": true, "label": "Data de assinatura", "group": "Foro e assinatura" }
  },
  "rules": [
    { "type": "differs", "a": "senhorio_nif", "b": "arrendatario_nif", "severity": "warning" },
    { "type": "required_if", "field": "mobiliario_descricao", "when": { "field": "mobilado", "nonEmpty": true } },
    { "type": "required_if", "field": "obras_previas_descricao", "when": { "field": "obras_previas", "nonEmpty": true } },
    { "type": "required_if", "field": "caucao_valor", "when": { "field": "caucao", "nonEmpty": true } },
    { "type": "required_if", "field": "fiador_nome", "when": { "field": "fiador", "nonEmpty": true } },
    { "type": "required_if", "field": "fiador_nif", "when": { "field": "fiador", "nonEmpty": true } },
    { "type": "required_if", "field": "fiador_morada", "when": { "field": "fiador", "nonEmpty": true } }
  ]
}
