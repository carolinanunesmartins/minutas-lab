      "label": "Houve mediação imobiliária?",
      "group": "Mediação",
      "required": false,
      "help": "Ativa ou desativa o bloco correspondente do contrato."
    },
    "mediadora_nome": {
      "label": "Nome da mediadora",
      "group": "Mediação",
      "required": false
    },
    "mediadora_nipc": {
      "label": "NIPC da mediadora",
      "group": "Mediação",
      "required": false
    },
    "mediadora_licenca_ami": {
      "label": "N.º da licença AMI",
      "group": "Mediação",
      "required": false
    },
    "reconhecimento_presencial": {
      "label": "Assinaturas reconhecidas presencialmente?",
      "group": "Reconhecimento",
      "required": true,
      "help": "Ativa ou desativa o bloco correspondente do contrato."
    },
    "reconhecimento_entidade": {
      "label": "Entidade que reconhece as assinaturas",
      "group": "Reconhecimento",
      "required": false
    },
    "foro_comarca": {
      "label": "Comarca do foro",
      "group": "Foro e assinatura",
      "required": true
    },
    "contrato_local": {
      "label": "Local de assinatura",
      "group": "Foro e assinatura",
      "required": true
    },
    "contrato_data": {
      "label": "Data de assinatura",
      "group": "Foro e assinatura",
      "required": true
    }
  },
  "rules": [
    {
      "type": "sum_eq",
      "fields": [
        "sinal_valor",
        "reforco_valor",
        "remanescente_valor"
      ],
      "total": "preco_total",
      "severity": "error"
    },
    {
      "type": "date_after",
      "field": "escritura_data_limite",
      "than": "today",
      "severity": "error"
    },
    {
      "type": "date_after",
      "field": "vendedor_cc_validade",
      "than": "escritura_data_limite",
      "severity": "warning"
    },
    {
      "type": "date_after",
      "field": "comprador_cc_validade",
      "than": "escritura_data_limite",
      "severity": "warning"
    },
    {
      "type": "differs",
      "a": "vendedor_nif",
      "b": "comprador_nif",
      "severity": "warning"
    },
    {
      "type": "differs",
      "a": "vendedor_iban",
      "b": "comprador_iban",
      "severity": "warning"
    },
    {
      "type": "required_if",
      "field": "onus_descricao",
      "when": {
        "field": "onus",
        "nonEmpty": true
      }
    },
    {
      "type": "required_if",
      "field": "onus_prorrogacao_dias",
      "when": {
        "field": "onus",
        "nonEmpty": true
      }
    },
    {
      "type": "required_if",
      "field": "arrendamento_data",
      "when": {
        "field": "arrendado",
        "nonEmpty": true
      }
    },
    {
      "type": "required_if",
      "field": "arrendamento_condicoes",
      "when": {
        "field": "arrendado",
        "nonEmpty": true
      }
    },
    {
      "type": "required_if",
      "field": "reforco_valor",
      "when": {
        "field": "reforco",
        "nonEmpty": true
      }
    },
    {
      "type": "required_if",
      "field": "reforco_data",
      "when": {
        "field": "reforco",
        "nonEmpty": true
      }
    },
    {
      "type": "required_if",
      "field": "financiamento_prazo",
      "when": {
        "field": "financiamento",
        "nonEmpty": true
      }
    },
    {
      "type": "required_if",
      "field": "mediadora_nome",
      "when": {
        "field": "mediacao",
        "nonEmpty": true
      }
    },
    {
      "type": "required_if",
      "field": "mediadora_nipc",
      "when": {
        "field": "mediacao",
        "nonEmpty": true
      }
    },
    {
      "type": "required_if",
      "field": "mediadora_licenca_ami",
      "when": {
        "field": "mediacao",
        "nonEmpty": true
      }
    },
    {
      "type": "required_if",
      "field": "reconhecimento_entidade",
      "when": {
        "field": "reconhecimento_presencial",
        "nonEmpty": true
      }
    }
  ]
}