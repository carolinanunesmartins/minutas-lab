{
  "id": "empreitada",
  "title": "Contrato de Empreitada",
  "version": "0.1.0",
  "groups": [
    { "id": "Dono da Obra", "label": "Dono da Obra", "order": 0 },
    { "id": "Empreiteiro", "label": "Empreiteiro", "order": 1 },
    { "id": "Obra", "label": "Obra", "order": 2 },
    { "id": "Preço e pagamento", "label": "Preço e pagamento", "order": 3 },
    { "id": "Prazo", "label": "Prazo", "order": 4 },
    { "id": "Seguro e penalizações", "label": "Seguro e penalizações", "order": 5 },
    { "id": "Garantia", "label": "Garantia", "order": 6 },
    { "id": "Foro e assinatura", "label": "Foro e assinatura", "order": 7 }
  ],
  "fields": {
    "dono_obra_nome": { "required": true, "label": "Nome do dono da obra", "group": "Dono da Obra" },
    "dono_obra_estado_civil": { "required": true, "label": "Estado civil (e regime de bens, se casado)", "group": "Dono da Obra", "options": ["Solteiro(a), maior", "Casado(a) em comunhão de adquiridos", "Casado(a) em comunhão geral de bens", "Casado(a) em separação de bens", "Divorciado(a)", "Viúvo(a)", "União de facto"] },
    "dono_obra_nif": { "required": true, "label": "NIF do dono da obra", "group": "Dono da Obra" },
    "dono_obra_morada": { "required": true, "label": "Morada de residência do dono da obra", "group": "Dono da Obra" },
    "dono_obra_email": { "required": true, "label": "E-mail do dono da obra", "group": "Dono da Obra" },
    "empreiteiro_nome": { "required": true, "label": "Firma/nome do empreiteiro", "group": "Empreiteiro" },
    "empreiteiro_nipc": { "required": true, "label": "NIPC do empreiteiro", "group": "Empreiteiro" },
    "empreiteiro_alvara": { "required": true, "label": "N.º do alvará de construção", "group": "Empreiteiro" },
    "empreiteiro_morada": { "required": true, "label": "Sede/morada do empreiteiro", "group": "Empreiteiro" },
    "empreiteiro_email": { "required": true, "label": "E-mail do empreiteiro", "group": "Empreiteiro" },
    "obra_descricao": { "required": true, "label": "Descrição dos trabalhos", "group": "Obra" },
    "obra_local": { "required": true, "label": "Local da obra", "group": "Obra" },
    "obra_freguesia": { "required": true, "label": "Freguesia", "group": "Obra" },
    "obra_concelho": { "required": true, "label": "Concelho", "group": "Obra" },
    "preco_total": { "required": true, "label": "Preço global da empreitada", "group": "Preço e pagamento" },
    "preco_iva_incluido": { "required": true, "label": "O preço inclui IVA?", "group": "Preço e pagamento", "help": "Ativa ou desativa o bloco correspondente do contrato." },
    "adiantamento": { "label": "Há adiantamento?", "group": "Preço e pagamento", "help": "Ativa ou desativa o bloco correspondente do contrato." },
    "adiantamento_valor": { "label": "Valor do adiantamento", "group": "Preço e pagamento" },
    "pagamento_faseado": { "required": true, "label": "O pagamento é faseado?", "group": "Preço e pagamento", "help": "Ativa ou desativa o bloco correspondente do contrato." },
    "pagamento_condicoes": { "label": "Condições do pagamento faseado", "group": "Preço e pagamento" },
    "retencao_garantia": { "label": "Há retenção de garantia sobre os pagamentos?", "group": "Preço e pagamento", "help": "Ativa ou desativa o bloco correspondente do contrato." },
    "retencao_percentagem": { "label": "Percentagem de retenção", "group": "Preço e pagamento" },
    "data_inicio": { "required": true, "label": "Data de início dos trabalhos", "group": "Prazo" },
    "prazo_dias": { "required": true, "label": "Prazo de execução (dias)", "group": "Prazo" },
    "materiais_por_conta": { "required": true, "label": "Quem fornece materiais e meios", "group": "Obra", "default": "conta do Empreiteiro", "options": ["conta do Empreiteiro", "conta do Dono da Obra", "conta de ambos, conforme orçamento"] },
    "seguro_obra": { "label": "Há obrigação de seguro de obra?", "group": "Seguro e penalizações", "help": "Ativa ou desativa o bloco correspondente do contrato." },
    "seguradora_nome": { "label": "Seguradora", "group": "Seguro e penalizações" },
    "penalizacao_atraso": { "label": "Há penalização por atraso?", "group": "Seguro e penalizações", "help": "Ativa ou desativa o bloco correspondente do contrato." },
    "penalizacao_valor_dia": { "label": "Valor da penalização por dia de atraso", "group": "Seguro e penalizações" },
    "garantia_anos": { "required": true, "label": "Prazo de garantia (anos)", "group": "Garantia", "default": "5" },
    "foro_comarca": { "required": true, "label": "Comarca do foro", "group": "Foro e assinatura" },
    "contrato_local": { "required": true, "label": "Local de assinatura", "group": "Foro e assinatura" },
    "contrato_data": { "required": true, "label": "Data de assinatura", "group": "Foro e assinatura" }
  },
  "rules": [
    { "type": "required_if", "field": "adiantamento_valor", "when": { "field": "adiantamento", "nonEmpty": true } },
    { "type": "required_if", "field": "pagamento_condicoes", "when": { "field": "pagamento_faseado", "nonEmpty": true } },
    { "type": "required_if", "field": "retencao_percentagem", "when": { "field": "retencao_garantia", "nonEmpty": true } },
    { "type": "required_if", "field": "seguradora_nome", "when": { "field": "seguro_obra", "nonEmpty": true } },
    { "type": "required_if", "field": "penalizacao_valor_dia", "when": { "field": "penalizacao_atraso", "nonEmpty": true } }
  ]
}
